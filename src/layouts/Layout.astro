<nav class="dn"><a href="/care">Our Care</a><a href="/about">Meet the Doctor</a><a href="/membership">Membership</a><a href="/students">For Students</a><a href="/privacy">Privacy</a><a class="btn" href="/join">Join</a></nav>
<details class="mn"><summary>Menu</summary><div><a href="/care">Our Care</a><a href="/about">Meet the Doctor</a><a href="/membership">Membership</a><a href="/students">For Students</a><a href="/privacy">Privacy</a><a href="/join">Join</a></div></details></div></header>
<main><slot /></main>
<footer><div class="w fg"><div><b>Kin &amp; Campus</b><p>Personalized care for college students.<br>Blacksburg, VA &middot; [ADDRESS] &middot; [PHONE]</p></div><div><a href="/care">Our Care</a><a href="/about">Meet the Doctor</a><a href="/membership">Membership</a><a href="/students">For Students</a><a href="/privacy">Privacy Promise</a><a href="/join">Join</a></div><div><p>In an emergency, call 911.</p><p>Kin &amp; Campus is an independent practice and is not affiliated with Virginia Tech.</p></div></div></footer>
</body></html>
