import Layout from "../layouts/Layout.astro";
import { href } from "../lib/paths";
---
<Layout title="Healthcare for college students in Blacksburg | Kin & Campus" description="Work with a local pediatrician on medication follow-up, common illnesses, forms, and the practical skills that make healthcare easier to manage.">
<div class="w ph"><div class="eyebrow">For students</div><h1>A doctor who can help you manage health during college.</h1><p class="lead">Kin &amp; Campus is a membership-based program for students in Blacksburg. You have an ongoing relationship with a board-certified pediatrician who can help with existing treatment, common illnesses, and the practical questions that come with handling more of your own healthcare.</p></div>
<div class="w">
<div class="notes">
<div class="note-row"><h3>Your regular treatment</h3><p>If you already take medication for ADHD, anxiety or depression, asthma, allergies, or acne, we can review the plan and provide appropriate follow-up while you are in Blacksburg.</p></div>
<div class="note-row"><h3>When you feel unwell</h3><p>Because we know your history and usual health, we can evaluate common illnesses with more context and help you understand what to do next.</p></div>
<div class="note-row"><h3>Appointments, refills, and questions</h3><p>You will get practice scheduling care, requesting prescriptions before they run out, describing symptoms, and understanding the choices in your treatment.</p></div>
<div class="note-row"><h3>Your privacy</h3><p>Your medical information is yours. We only involve a parent with your consent, except where the law permits or requires action to protect health or safety.</p></div>
</div>

<div class="eyebrow" style="margin-top:56px">How the year works</div>
<h2>We make room for the times college tends to disrupt a health plan.</h2>
<div class="notes">
<div class="note-row"><h3>At the beginning</h3><p>We learn your history, current medications, and goals, then identify anything that needs to be arranged before the semester becomes busy.</p></div>
<div class="note-row"><h3>Before breaks and finals</h3><p>These are sensible times to review prescriptions, symptoms, sleep, and stress so that routine care does not get lost in a demanding schedule.</p></div>
<div class="note-row"><h3>When paperwork comes up</h3><p>Bring university, housing, sports, travel, or immunization forms for clinical review. We will explain what we can complete and what records are needed.</p></div>
<div class="note-row"><h3>When the plan changes</h3><p>We can coordinate with your hometown physician when it would improve your care and you have authorized us to do so.</p></div>
</div>
<p style="margin-top:36px"><a class="btn" href={href("join")}>Ask about the program</a></p>
</div>
</Layout>
