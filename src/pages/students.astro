---
import Layout from "../layouts/Layout.astro";
---
<Layout title="For Students | Kin & Campus">
<div class="w ph"><div class="eyebrow">For students</div><h1>A doctor who's on your side.</h1><p class="lead">Your parents signed you up. This is still your doctor, and your health is yours.</p></div>
<div class="w"><div class="grid"><div class="card"><svg class="ic" aria-hidden="true"><use href="#i-shield"/></svg><h3>You're in charge</h3><p>You decide what we tell your family. Change it anytime.</p></div><div class="card"><svg class="ic" aria-hidden="true"><use href="#i-chat"/></svg><h3>Text us</h3><p>No phone tree, no waiting room line. Ask the question you're embarrassed about.</p></div><div class="card"><svg class="ic" aria-hidden="true"><use href="#i-leaf"/></svg><h3>Real help, no lecture</h3><p>Sleep, stress, meds, food. We help you figure out what works for you.</p></div></div></div>
</Layout>
