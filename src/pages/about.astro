import Layout from "../layouts/Layout.astro";
---
<Layout title="Meet the Doctor | Kin & Campus">
<div class="w ph"><div class="eyebrow">Meet the doctor</div><h1>Dr. [NAME], [CREDENTIALS]</h1></div>
<div class="w split"><svg class="art" viewBox="0 0 360 360" role="img" aria-label="Portrait placeholder"><rect width="360" height="360" rx="28" fill="#EADFCB"/><circle cx="180" cy="140" r="56" fill="#9CAF98"/><path d="M70 330q110-150 220 0z" fill="#6B2737"/><circle cx="270" cy="86" r="20" fill="none" stroke="#C9A24B" stroke-width="8"/></svg>
<div><p class="lead">[YOUR STORY: why you started Kin &amp; Campus. Parents connect with a real reason, in your own words.]</p><p>[TRAINING, BOARD CERTIFICATION, YEARS IN PRACTICE, FAMILY IN BLACKSBURG]</p><h3 style="margin-top:28px">How I practice</h3><p>I take time to know each student, treat them as the capable adult they are, and keep their family informed in the way they choose.</p></div></div>
</Layout>
