---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Start a conversation | Kin & Campus" description="Request an introductory conversation about Kin & Campus. The form collects contact details only, not medical information.">
<div class="w ph"><div class="eyebrow">Getting started</div><h1>Tell us a little about who is interested in the program.</h1><p class="lead">We will use these details to arrange an introductory conversation. Please do not include symptoms, diagnoses, medications, or medical records.</p></div>
<div class="w">
<form id="ob" class="ob form" action="#" method="POST">
<p id="ob-prog" class="ob-prog" aria-live="polite">Question 1 of 5</p>
<p id="ob-cb" class="ob-cb" hidden aria-live="polite"></p>

<div class="step" data-step="who">
<h2>Who is interested in Kin &amp; Campus?</h2>
<div class="ob-opts">
<button type="button" class="ob-opt" data-field="who" data-value="first-year">Incoming first-year</button>
<button type="button" class="ob-opt" data-field="who" data-value="on-campus">Already on campus</button>
<button type="button" class="ob-opt" data-field="who" data-value="graduate">Graduate student</button>
<button type="button" class="ob-opt" data-field="who" data-value="student">I'm the student</button>
</div>
</div>

<div class="step" data-step="when" hidden>
<h2>When would they like to begin?</h2>
<div class="ob-opts">
<button type="button" class="ob-opt" data-field="when" data-value="summer">This summer</button>
<button type="button" class="ob-opt" data-field="when" data-value="august">Before August</button>
<button type="button" class="ob-opt" data-field="when" data-value="here">Already here</button>
</div>
</div>

<div class="step" data-step="year" hidden>
<h2>Where are you in your college experience?</h2>
<div class="ob-opts">
<button type="button" class="ob-opt" data-field="year" data-value="first-year">Incoming first-year</button>
<button type="button" class="ob-opt" data-field="year" data-value="here">Already here</button>
<button type="button" class="ob-opt" data-field="year" data-value="graduate">Graduate student</button>
</div>
</div>

<div class="step" data-step="doctor" hidden>
<h2 id="doctor-q">Is there a hometown physician involved in current care?</h2>
<div class="ob-opts">
<button type="button" class="ob-opt" data-field="doctor" data-value="yes">Yes</button>
<button type="button" class="ob-opt" data-field="doctor" data-value="not-yet">Not yet</button>
<button type="button" class="ob-opt" data-field="doctor" data-value="later">We'll decide on the call</button>
</div>
</div>

<div class="step" data-step="city" hidden>
<h2>What city do you call home?</h2>
<label>Hometown city only<input name="hometown_city" id="hometown_city" maxlength="80" autocomplete="address-level2" placeholder="Richmond, Charlotte…"></label>
<p class="note">City only, please. We will discuss medical care later through the appropriate secure process.</p>
<div class="ob-nav"><button class="btn" type="button" id="city-go">Continue</button></div>
</div>

<div class="step" data-step="call" hidden>
<h2 id="call-q">Who should we contact?</h2>
<label>First name<input name="first_name" id="first_name" required maxlength="40" autocomplete="given-name"></label>
<label>Mobile<input type="tel" name="phone" id="phone" required maxlength="20" autocomplete="tel" inputmode="tel"></label>
<p class="note" id="call-note">We will contact you about the program. This website does not collect medical history.</p>
<p class="ob-times">Best time <span>(optional)</span></p>
<div class="ob-opts ob-opts-row">
<button type="button" class="ob-opt" data-field="time" data-value="morning">Morning</button>
<button type="button" class="ob-opt" data-field="time" data-value="after-work">After work</button>
<button type="button" class="ob-opt" data-field="time" data-value="weekend">Weekend</button>
</div>
<div class="ob-nav"><button class="btn" type="submit" id="call-go">Request a call</button></div>
</div>
<p id="ob-skip" class="ob-skip"><button class="lnk ob-call" type="button">Go directly to contact details</button></p>
</form>

<p id="ob-err" class="note" hidden>We couldn't send that. Try again in a moment.</p>
<div id="ty" class="card" hidden>
<h2>Thank you. We will be in touch about an introductory conversation.</h2>
</div>
</div>

<script is:inline>
(function () {
  var form = document.getElementById("ob");
  var thanks = document.getElementById("ty");
  var prog = document.getElementById("ob-prog");
  var cb = document.getElementById("ob-cb");
  var answers = { path: "parent", who: "", when: "", year: "", doctor: "", city: "", name: "", phone: "", time: "" };
  var parentOrder = ["who", "when", "doctor", "city", "call"];
  var studentOrder = ["year", "doctor", "city", "call"];

  function order() {
    return answers.path === "student" ? studentOrder : parentOrder;
  }

  function show(step) {
    var steps = form.querySelectorAll(".step");
    var i;
    for (i = 0; i < steps.length; i++) {
      steps[i].hidden = steps[i].getAttribute("data-step") !== step;
    }
    var seq = order();
    var n = seq.indexOf(step) + 1;
    prog.textContent = "Question " + n + " of " + seq.length;
    document.getElementById("ob-skip").hidden = step === "call";
    if (step === "call") {
      document.getElementById("call-q").textContent = answers.path === "student" ? "What is the best number for you?" : "Who should we contact?";
      document.getElementById("call-note").textContent = answers.path === "student"
        ? "We will use this number to contact you about the program. Please do not submit medical information here."
        : "We will contact you about the program. This website does not collect medical history.";
    }
  }

  function callback(text) {
    if (!text) {
      cb.hidden = true;
      cb.textContent = "";
      return;
    }
    cb.hidden = false;
    cb.textContent = text;
  }

  function whoLine(value) {
    switch (value) {
      case "first-year":
        return "We will discuss what an incoming student's first year may require.";
      case "on-campus":
        return "We will discuss whether the program fits their current needs in Blacksburg.";
      case "graduate":
        return "We will discuss whether the program fits a graduate student's needs.";
      case "student":
        return "We will speak with you directly about the program.";
      default:
        throw new Error("unknown who");
    }
  }

  function whenLine(value) {
    switch (value) {
      case "summer":
        return "We will discuss a summer start.";
      case "august":
        return "We will discuss beginning before August.";
      case "here":
        return "We will discuss getting started while they are already in Blacksburg.";
      default:
        throw new Error("unknown when");
    }
  }

  function yearLine(value) {
    switch (value) {
      case "first-year":
        return "We will discuss beginning care before the semester gets busy.";
      case "here":
        return "We will discuss getting started while you are already in Blacksburg.";
      case "graduate":
        return "We will discuss whether the program fits your needs as a graduate student.";
      default:
        throw new Error("unknown year");
    }
  }

  function doctorLine(value) {
    switch (value) {
      case "yes":
        return answers.path === "student"
          ? "We can discuss appropriate coordination with your hometown physician."
          : "We can discuss appropriate coordination with their hometown physician.";
      case "not-yet":
        return "There is no hometown physician to coordinate with at present.";
      case "later":
        return "We can discuss this during the introductory conversation.";
      default:
        throw new Error("unknown doctor");
    }
  }

  function nextAfter(step) {
    var seq = order();
    var i = seq.indexOf(step);
    return seq[Math.min(i + 1, seq.length - 1)];
  }

  form.addEventListener("click", function (e) {
    var t = e.target;
    if (!(t instanceof HTMLElement)) return;
    if (t.classList.contains("ob-call")) {
      show("call");
      return;
    }
    var field = t.getAttribute("data-field");
    var value = t.getAttribute("data-value");
    if (!field || !value) return;
    if (field === "time") {
      answers.time = value;
      var times = form.querySelectorAll('[data-field="time"]');
      var i;
      for (i = 0; i < times.length; i++) times[i].setAttribute("aria-pressed", times[i] === t ? "true" : "false");
      return;
    }
    answers[field] = value;
    if (field === "who") {
      answers.path = value === "student" ? "student" : "parent";
      callback(whoLine(value));
      show(value === "student" ? "year" : "when");
      return;
    }
    if (field === "when") {
      callback(whenLine(value));
      show(nextAfter("when"));
      return;
    }
    if (field === "year") {
      callback(yearLine(value));
      show(nextAfter("year"));
      return;
    }
    if (field === "doctor") {
      callback(doctorLine(value));
      show(nextAfter("doctor"));
    }
  });

  document.getElementById("city-go").addEventListener("click", function () {
    var city = document.getElementById("hometown_city").value.trim();
    if (city.length < 2) {
      document.getElementById("hometown_city").focus();
      return;
    }
    answers.city = city;
    callback("Coming from " + city + ".");
    show("call");
  });

  function labelWho(value) {
    switch (value) {
      case "first-year":
        return "Incoming first-year";
      case "on-campus":
        return "Already on campus";
      case "graduate":
        return "Graduate student";
      case "student":
        return "I'm the student";
      case "":
        return "";
      default:
        throw new Error("unknown who");
    }
  }

  function labelWhen(value) {
    switch (value) {
      case "summer":
        return "This summer";
      case "august":
        return "Before August";
      case "here":
        return "Already here";
      case "":
        return "";
      default:
        throw new Error("unknown when");
    }
  }

  function labelYear(value) {
    switch (value) {
      case "first-year":
        return "Incoming first-year";
      case "here":
        return "Already here";
      case "graduate":
        return "Graduate student";
      case "":
        return "";
      default:
        throw new Error("unknown year");
    }
  }

  function labelDoctor(value) {
    switch (value) {
      case "yes":
        return "Yes";
      case "not-yet":
        return "Not yet";
      case "later":
        return "We'll decide on the call";
      case "":
        return "";
      default:
        throw new Error("unknown doctor");
    }
  }

  function labelTime(value) {
    switch (value) {
      case "morning":
        return "Morning";
      case "after-work":
        return "After work";
      case "weekend":
        return "Weekend";
      case "":
        return "";
      default:
        throw new Error("unknown time");
    }
  }

  var err = document.getElementById("ob-err");
  var go = document.getElementById("call-go");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    var name = document.getElementById("first_name").value.trim();
    var phone = document.getElementById("phone").value.trim();
    if (!name || !phone) return;
    answers.name = name;
    answers.phone = phone;
    answers.city = document.getElementById("hometown_city").value.trim();
    err.hidden = true;
    go.disabled = true;
    var payload = {
      _subject: "Kin & Campus introductory call request",
      path: answers.path,
      who: labelWho(answers.who),
      timing: answers.path === "student" ? labelYear(answers.year) : labelWhen(answers.when),
      hometown_doctor: labelDoctor(answers.doctor),
      city: answers.city,
      first_name: answers.name,
      mobile: answers.phone,
      best_time: labelTime(answers.time)
    };
    fetch("https://formsubmit.co/ajax/brwaddell@gmail.com", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify(payload)
    }).then(function (res) {
      if (!res.ok) throw new Error("send failed");
      return res.json();
    }).then(function () {
      form.hidden = true;
      thanks.hidden = false;
    }).catch(function () {
      go.disabled = false;
      err.hidden = false;
    });
  });

  show("who");
})();
</script>
</div>
</Layout>
